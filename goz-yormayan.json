{
  "document": {
    "margin": 2
  },
  "block_quote": {
    "indent": 1,
    "indent_token": "│ ",
    "color": "#9ccfd8",
    "italic": true
  },
  "paragraph": {
    "color": "#e0def4"
  },
  "list": {
    "level_indent": 2
  },
  "heading": {
    "color": "#c4a7e7",
    "bold": true
  },
  "h1": {
    "color": "#eb6f92",
    "bold": true,
    "underline": true
  },
  "h2": {
    "color": "#ea9a97",
    "bold": true
  },
  "h3": {
    "color": "#f6c177"
  },
  "h4": {
    "color": "#9ccfd8"
  },
  "h5": {
    "color": "#3e8fb0"
  },
  "h6": {
    "color": "#6e6a86"
  },
  "text": {
    "color": "#e0def4"
  },
  "strikethrough": {
    "color": "#6e6a86",
    "crossed_out": true
  },
  "emph": {
    "italic": true
  },
  "strong": {
    "bold": true,
    "color": "#f6c177"
  },
  "hr": {
    "color": "#393552",
    "format": "\n--------\n"
  },
  "item": {
    "color": "#e0def4"
  },
  "enumeration": {
    "color": "#c4a7e7"
  },
  "task": {
    "ticked": "[x] ",
    "unticked": "[ ] ",
    "color": "#9ccfd8"
  },
  "link": {
    "color": "#c4a7e7",
    "underline": true
  },
  "link_text": {
    "color": "#c4a7e7",
    "bold": true
  },
  "image": {
    "color": "#9ccfd8",
    "underline": true
  },
  "image_text": {
    "color": "#9ccfd8",
    "format": "Image: {{.text}}"
  },
  "code": {
    "color": "#ea9a97",
    "background_color": "#2a273f"
  },
  "code_block": {
    "margin": 2,
    "color": "#e0def4",
    "background_color": "#2a273f",
    "chroma": {
      "text": { "color": "#e0def4" },
      "error": { "color": "#eb6f92" },
      "comment": { "color": "#6e6a86", "italic": true },
      "keyword": { "color": "#3e8fb0" },
      "operator": { "color": "#9ccfd8" },
      "punctuation": { "color": "#908caa" },
      "name": { "color": "#e0def4" },
      "name_tag": { "color": "#eb6f92" },
      "name_attribute": { "color": "#f6c177" },
      "name_function": { "color": "#c4a7e7" },
      "name_variable": { "color": "#ea9a97" },
      "literal_string": { "color": "#f6c177" },
      "literal_number": { "color": "#eb6f92" }
    }
  },
  "table": {
    "center_separator": "┼",
    "column_separator": "│",
    "row_separator": "─"
  },
  "definition_list": {},
  "definition_term": {
    "color": "#f6c177"
  },
  "definition_description": {
    "color": "#e0def4"
  }
}
